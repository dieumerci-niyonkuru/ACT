# =====================================================================
# Security policy for upload folders
# =====================================================================

# --- No script execution ---
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|jsp|asp|aspx|cgi|sh|shtml)$">
    Require all denied
</FilesMatch>


# --- Disable PHP processing entirely (for mod_php setups) ---
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# --- Disable CGI/SSI execution ---
Options -ExecCGI -Indexes -Includes -MultiViews

# --- Remove handlers for risky extensions ---
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveHandler .pl .py .jsp .asp .aspx .cgi .sh .shtml
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveType .pl .py .jsp .asp .aspx .cgi .sh .shtml
</IfModule>

# --- Force safe MIME types for common uploads ---
<IfModule mod_mime.c>
    AddType application/pdf .pdf
    AddType image/jpeg .jpg .jpeg
    AddType image/png .png
    AddType image/gif .gif
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

